---
// src/integrations/onesignal/OneSignalPush.astro
/**
 * OneSignal Web Push integration (available by default, disabled by default).
 *
 * It only runs when BOTH IDs are provided:
 * - PUBLIC_ONESIGNAL_APP_ID
 * - PUBLIC_ONESIGNAL_SAFARI_WEB_ID
 *
 * Integration is consent-gated with data-consent-category="functional".
 */

const ONESIGNAL_APP_ID = import.meta.env.PUBLIC_ONESIGNAL_APP_ID?.trim();
const ONESIGNAL_SAFARI_WEB_ID =
  import.meta.env.PUBLIC_ONESIGNAL_SAFARI_WEB_ID?.trim();
const ONESIGNAL_NOTIFY_BUTTON =
  (import.meta.env.PUBLIC_ONESIGNAL_NOTIFY_BUTTON ?? "true") !== "false";

const hasOneSignalConfig = Boolean(ONESIGNAL_APP_ID && ONESIGNAL_SAFARI_WEB_ID);
---

{hasOneSignalConfig && (
  <>
    <script
      type="text/plain"
      data-consent-category="functional"
      is:inline
      define:vars={{
        ONESIGNAL_APP_ID,
        ONESIGNAL_SAFARI_WEB_ID,
        ONESIGNAL_NOTIFY_BUTTON,
      }}
    >
      (function () {
        var started = false;
        var idleHandle;
        var bellSelector =
          "[data-onesignal-bell], #onesignal-bell-container, .onesignal-bell-launcher-button";

        function initializeOneSignal() {
          if (started) return;
          started = true;
          if (idleHandle && "cancelIdleCallback" in window) {
            window.cancelIdleCallback(idleHandle);
          }

          window.OneSignalDeferred = window.OneSignalDeferred || [];
          window.OneSignalDeferred.push(async function (OneSignal) {
            await OneSignal.init({
              appId: ONESIGNAL_APP_ID,
              safari_web_id: ONESIGNAL_SAFARI_WEB_ID,
              notifyButton: { enable: ONESIGNAL_NOTIFY_BUTTON },
            });
          });

          var sdk = document.createElement("script");
          sdk.src = "https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js";
          sdk.defer = true;
          document.head.appendChild(sdk);
        }

        function scheduleAfterLoad() {
          var scheduleIdle = function () {
            if ("requestIdleCallback" in window) {
              idleHandle = window.requestIdleCallback(initializeOneSignal, {
                timeout: 4000,
              });
            } else {
              window.setTimeout(initializeOneSignal, 1500);
            }
          };
          if (document.readyState === "complete") scheduleIdle();
          else window.addEventListener("load", scheduleIdle, { once: true });
        }

        document.addEventListener(
          "pointerdown",
          function (event) {
            if (event.target instanceof Element && event.target.closest(bellSelector)) {
              initializeOneSignal();
            }
          },
          { capture: true, passive: true },
        );

        scheduleAfterLoad();
      })();
    </script>
  </>
)}
