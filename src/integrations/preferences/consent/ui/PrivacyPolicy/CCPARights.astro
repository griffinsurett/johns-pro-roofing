---
// src/integrations/preferences/ui/consent/components/PrivacyPolicy/CCPARights.astro
/**
 * CCPA Rights Component
 *
 * Displays California Consumer Privacy Act (CCPA/CPRA) information including:
 * - Explanation of "sale" or "sharing" under California law
 * - That nothing is sold or shared (services are listed in "Services We Use",
 *   from utils/privacy.ts)
 * - Opt-out controls (opt out of everything, cookie settings, browser signals)
 * - California consumer rights (know, delete, opt-out, correct, non-discrimination)
 * - Categories of personal information collected
 * - How to exercise rights with contact information
 *
 * Laid out as an ordinary section of the legal document; only the two things a
 * visitor acts on (the opt-out controls and the contact details) sit in cards
 * (`.legal-card`, styled in legal.css).
 */
import OptOutButton from "../OptOutButton";
import Button from "@/components/Button/Button";
import { find } from "@/utils/query";
import { formatPhoneNumber } from "@/utils/string";

interface Props {
  sectionNumber?: number; // Optional section number for sequential numbering
}

const { sectionNumber } = Astro.props;

// Query contact information dynamically from contact-us collection
const emailEntry = await find("contact-us", "email");
const phoneEntry = await find("contact-us", "phone");
const emailValue = emailEntry?.data?.value ?? emailEntry?.data?.description ?? emailEntry?.data?.title ?? "";
const phoneValue = phoneEntry?.data?.value ?? phoneEntry?.data?.description ?? phoneEntry?.data?.title ?? "";
---

<section id="ccpa-rights">
  <h2>
    {sectionNumber ? `${sectionNumber}. ` : ""}California Privacy Rights (CCPA)
  </h2>
  <p>
    Under California law (CCPA/CPRA), "sale" or "sharing" means making your
    personal information available to third parties in exchange for anything of
    value, including for advertising or analytics.
  </p>
  <p>
    <strong>We don't sell your personal information or share it for
    advertising.</strong> The services listed under "Services We Use" above
    only help run this website. No advertising or tracking tools are installed.
  </p>

  <div class="legal-card">
    <h3>Do not sell or share my personal information</h3>
    <p>
      Nothing on this site sells or shares your information today. These
      controls still let you turn off every non-essential cookie at once, or
      category by category, and they apply to anything added later.
    </p>
    <div class="legal-card__actions">
      <OptOutButton client:visible />
      {/* Opens the cookie preferences modal through the same event the
          footer's "Your Privacy Choices" button sends (script below). */}
      <Button variant="secondary" type="button" data-open-cookie-settings>
        Cookie settings
      </Button>
    </div>
    <p class="legal-card__note">
      We also honor Global Privacy Control and Do Not Track signals from your
      browser and treat them as an opt-out.
    </p>
    <details class="legal-card__details">
      <summary>How to turn on Do Not Track</summary>
      <ul>
        <li><strong>Chrome:</strong> Settings → Privacy and security → Do Not Track</li>
        <li><strong>Firefox:</strong> Settings → Privacy &amp; Security → Do Not Track</li>
        <li><strong>Safari:</strong> Settings → Privacy → Ask websites not to track me</li>
        <li><strong>Edge:</strong> Settings → Privacy → Do Not Track</li>
      </ul>
    </details>
  </div>

  <h3>Your California privacy rights</h3>
  <p>If you're a California resident, you have these rights:</p>
  <ul>
    <li>
      <strong>Right to know:</strong> ask what personal information we've
      collected about you in the past 12 months.
    </li>
    <li>
      <strong>Right to delete:</strong> ask us to delete your personal
      information, subject to certain exceptions.
    </li>
    <li>
      <strong>Right to opt out:</strong> stop the sale or sharing of your
      personal information (use the controls above).
    </li>
    <li>
      <strong>Right to correct:</strong> ask us to correct inaccurate personal
      information.
    </li>
    <li>
      <strong>Right to non-discrimination:</strong> we won't treat you
      differently for using these rights. Same service, same pricing.
    </li>
  </ul>

  <h3>Personal information we collect</h3>
  <ul>
    <li><strong>Identifiers:</strong> name, phone number, email address, IP address</li>
    <li><strong>Internet activity:</strong> pages visited, counted without cookies</li>
    <li><strong>Geolocation:</strong> approximate location (country) derived from your IP address</li>
    <li>
      <strong>Sensitive information:</strong> we do not collect Social Security
      numbers, financial data or health information
    </li>
  </ul>

  <h3>How to use your rights</h3>
  <div class="legal-card">
    <p>
      To ask for your data, ask us to delete it, or ask a question about your
      privacy, contact us:
    </p>
    <ul>
      {
        emailEntry && (
          <li>
            <strong>Email:</strong>{" "}
            <a href={`${emailEntry.data.linkPrefix || "mailto:"}${emailValue}`}>
              {emailValue}
            </a>
          </li>
        )
      }
      {
        phoneEntry && (
          <li>
            <strong>Phone:</strong>{" "}
            <a href={`${phoneEntry.data.linkPrefix || "tel:"}${phoneValue}`}>
              {formatPhoneNumber(phoneValue)}
            </a>
          </li>
        )
      }
      <li>
        <strong>In your message:</strong> start with "CCPA Request - [Right to
        Know/Delete/Correct]" and include your name, email and what you're asking for
      </li>
      <li><strong>Response time:</strong> within 45 days</li>
    </ul>
    <div class="legal-card__actions">
      {/* The site's primary button (forces white text, so the legal page's
          link colour can't hide it). Goes straight to the contact form. */}
      <Button variant="primary" href="/contact-us#contact-form" rightIcon="lu:arrow-right">
        Contact us about privacy
      </Button>
    </div>
    <p class="legal-card__note">
      To protect your privacy, we verify your identity before acting on a
      request. We may ask you to confirm recent interactions with our site or
      provide other identifying information. Authorized agents must provide
      proof of authorization.
    </p>
  </div>
</section>

<script>
  import { requestCookieSettings } from "@/integrations/preferences/consent/core/hooks/useZestConsent";

  document.querySelectorAll("[data-open-cookie-settings]").forEach((button) => {
    button.addEventListener("click", requestCookieSettings);
  });
</script>
