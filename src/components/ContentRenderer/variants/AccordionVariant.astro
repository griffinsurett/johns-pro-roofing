---
// src/components/ContentRenderer/variants/AccordionVariant.astro
/**
 * AccordionVariant - Refactored to use ContentBridge
 *
 * The ONLY change: Wrap Accordion in ContentBridge instead of manually
 * rendering hidden slots. Your existing Accordion.tsx works unchanged!
 */

import type { BaseVariantProps } from "../ContentRenderer.types";
import ContentBridge from "../ContentBridge/ContentBridge.astro";
import Accordion from "@/components/LoopTemplates/Accordion";
import Button from "@/components/Button/Button";
import SectionHeading from "@/components/SectionHeading.astro";
import { shouldShowCollectionCTA } from "../utils/helpers";

interface Props extends BaseVariantProps {
  allowMultiple?: boolean;
  pretitle?: string;
  /** Capture the actual rendered answers. Defaults on for the FAQ collection;
   *  disable for non-question accordions. Multiple FAQ sections aggregate. */
  schema?: boolean;
  collectionName?: string;
}

const {
  items = [],
  title,
  description,
  pretitle,
  className = "",
  allowMultiple = false,
  collectionUrl,
  collectionTitle,
  collectionName,
  schema = collectionName === "faq",
  id,
} = Astro.props as Props;

const viewAllText = `View All ${collectionTitle || ""}`.trim();
const bridgeId = id || "accordion";

// FAQPage structured data from the items rendered below (schema follows visible
// content). Built by the shared schema builder; `schema={false}` suppresses.
---


<section id={id} class={`py-16 ${className}`}>
  {/* Header Section */}
  {
    (pretitle || title || description) && (
      <SectionHeading pretitle={pretitle} title={title} description={description} />
    )
  }

  {/* Accordion with ContentBridge */}
  {
    items.length > 0 && (
      <ContentBridge items={items} bridgeId={bridgeId} schema={schema ? "faq" : false}>
        {/* 
        Your existing Accordion component!
        ContentBridge generates slot IDs as: `${bridgeId}-slot-${index}`
        Just pass that pattern to your Accordion as contentSlotId
      */}
        <Accordion
          items={items.map((item, index) => ({
            id: item.id,
            title: item.title || "Untitled",
            description: item.description,
            contentSlotId: `${bridgeId}-slot-${index}`, // ← ContentBridge created this ID
          }))}
          allowMultiple={allowMultiple}
          client:visible
        />
      </ContentBridge>
    )
  }

  {/* Collection CTA */}
  {
    shouldShowCollectionCTA(collectionUrl, items.length) && (
      <div class="mt-12 text-center">
        <Button
          href={collectionUrl}
          rightIcon="lu:arrow-right"
          variant="primary"
          size="lg"
        >
          {viewAllText}
        </Button>
      </div>
    )
  }
</section>
