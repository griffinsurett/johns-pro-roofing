---
// src/components/ContentRenderer/variants/ServiceListVariant.astro
/**
 * Service List Variant — editorial row list (Hymanson "Our Expertise" style).
 * Each item is a full-width row: title · description · arrow, with hairline
 * dividers. Driven by a collection query.
 */
import type { BaseVariantProps } from "../ContentRenderer.types";
import ServiceRow from "@/components/LoopComponents/ServiceRow.astro";
import SectionHeading from "@/components/SectionHeading.astro";

interface Props extends BaseVariantProps {
  pretitle?: string;
  /** Section headline. Falls back to `title` when not set (e.g. the collection
   *  `_meta.heading`). When both exist, `title` becomes the eyebrow. */
  heading?: string;
}

const {
  items = [],
  title,
  heading,
  description,
  pretitle,
  className = "",
  id,
} = Astro.props as Props;

// Match the site convention: eyebrow = pretitle or the collection title;
// the big headline = heading (falls back to title when no heading is given).
const eyebrow = pretitle ?? (heading ? title : undefined);
const headingText = heading ?? title;
---

<section id={id} class={`py-[100px] border-t border-border ${className}`}>
  <div class="container">
    {
      (eyebrow || headingText || description) && (
        <SectionHeading pretitle={eyebrow} title={headingText} description={description} />
      )
    }

    {
      items.length > 0 && (
        <ul class="mt-12 border-t border-heading/12 list-none [&>li:last-child]:border-b-0">
          {items.map((item) => (
            <ServiceRow {...item} />
          ))}
        </ul>
      )
    }
  </div>
</section>
