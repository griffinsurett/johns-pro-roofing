---
// src/components/ContentRenderer/variants/ServiceCalloutVariant.astro
/**
 * Service Callout Variant — photo band with a left-anchored red gradient
 * (opaque left → transparent right) and a numbered list of services, matching
 * the homepage "Ready for a better roof?" CTA treatment.
 *
 * The background is a cross-fading slideshow of the queried services' featured
 * images (CSS-only; freezes on the first image for reduced-motion users).
 * Items with a resolved url (e.g. roofing) render as links; page-less ones
 * (decking, siding) render as plain list entries.
 */
import { getImage } from "astro:assets";
import type { BaseVariantProps } from "../ContentRenderer.types";
import Button from "@/components/Button/Button";
import SectionHeading from "@/components/SectionHeading.astro";
import { resolveImageMetadata } from "@/utils/images";

interface Props extends BaseVariantProps {
  pretitle?: string;
  /** Optional CTA button under the list. */
  ctaText?: string;
  ctaLink?: string;
  /** Shared background image(s). When set, these render as the band background
   *  instead of the items' own featuredImages — use when the items carry no
   *  images of their own (e.g. the "Who We Serve" audience list). Pass a single
   *  image for a static band, or an array to cross-fade them as a slideshow. */
  backgroundImage?: any;
}

const {
  items = [],
  title,
  description,
  pretitle,
  className = "",
  ctaText,
  ctaLink,
  backgroundImage,
  id,
} = Astro.props as Props;

const safeItems = Array.isArray(items) ? items : [];

/**
 * Resolve a featuredImage (Astro image object or string) to a responsive
 * background source. Local images go through getImage so the band ships a
 * right-sized WebP instead of the full-resolution original; a plain string
 * (external/public path) passes through untouched.
 *
 * These sit behind an opaque red gradient, so quality can run low without a
 * visible difference.
 */
async function resolveSlide(
  featuredImage: any,
): Promise<{ src: string; srcset?: string } | null> {
  if (typeof featuredImage === "string") {
    return featuredImage ? { src: featuredImage } : null;
  }
  const meta = resolveImageMetadata(featuredImage);
  if (!meta) return null;

  const [w1280, w1920] = await Promise.all([
    getImage({ src: meta, width: 1280, format: "webp", quality: 60 }),
    getImage({ src: meta, width: 1920, format: "webp", quality: 60 }),
  ]);
  return {
    src: w1280.src,
    srcset: `${w1280.src} 1280w, ${w1920.src} 1920w`,
  };
}

// A shared backgroundImage (single or array) renders as the background frame(s);
// otherwise each item's featuredImage becomes a cross-fading slide.
const slideSources = backgroundImage
  ? (Array.isArray(backgroundImage) ? backgroundImage : [backgroundImage])
  : safeItems.map((i) => i.featuredImage);
const slides = (await Promise.all(slideSources.map(resolveSlide))).filter(
  Boolean,
) as { src: string; srcset?: string }[];
// One full cycle = N slides × time-per-slide; used to stagger each layer's delay.
const perSlide = 5; // seconds each image is featured
const cycle = Math.max(slides.length, 1) * perSlide;
// Only cross-fade when there's more than one image; a single image renders as a
// plain static background (no pulsing animation).
const isSlideshow = slides.length > 1;
---

<section id={id} class={`relative overflow-hidden ${className}`}>
  {/* Background: a cross-fading slideshow when multiple images are passed,
      otherwise a single static image. */}
  {slides.length > 0 && (
    <div class="absolute inset-0" aria-hidden="true">
      {slides.map((slide, i) => (
        <img
          src={slide.src}
          srcset={slide.srcset}
          sizes="100vw"
          alt=""
          loading="lazy"
          decoding="async"
          class={`absolute inset-0 w-full h-full object-cover ${isSlideshow ? "svc-slide" : ""}`}
          style={isSlideshow ? `animation-duration:${cycle}s; animation-delay:${i * perSlide}s;` : undefined}
        />
      ))}
    </div>
  )}
  {/* Red gradient overlay: opaque on the left, fading to transparent on the right */}
  <div
    class="absolute inset-0 bg-[linear-gradient(90deg,var(--color-accent)_0%,color-mix(in_oklab,var(--color-accent)_92%,transparent)_30%,color-mix(in_oklab,var(--color-accent)_55%,transparent)_62%,transparent_100%)]"
    aria-hidden="true"
  >
  </div>

  <div class="container relative z-10 py-[80px] lg:py-[100px]">
    <div class="max-w-[760px] text-bg">
      <SectionHeading
        align="left"
        pretitle={pretitle}
        title={title}
        description={description}
        pretitleClass="!text-bg"
        headingClass="!text-bg !text-[clamp(32px,4.5vw,52px)] leading-[1.05] !mb-4"
        descriptionClass="!text-bg/90 !text-lg !mb-8 max-w-[480px]"
      />

      {safeItems.length > 0 && (
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5 mb-10 list-none">
          {safeItems.map((item, i) => (
            <li class="flex items-center gap-4">
              <span class="flex-shrink-0 w-7 h-7 rounded-full bg-primary text-bg text-sm font-bold flex items-center justify-center">
                {i + 1}
              </span>
              <span class="text-bg text-lg font-semibold">{item.title}</span>
            </li>
          ))}
        </ul>
      )}

      {ctaText && ctaLink && (
        <Button variant="gradient" size="lg" href={ctaLink}>{ctaText}</Button>
      )}
    </div>
  </div>
</section>

<style>
  /* Each slide starts hidden and is faded up only during its own window
     (≈ first third of the shared cycle), staggered via animation-delay. */
  .svc-slide {
    opacity: 0;
    animation-name: svc-slide-fade;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    will-change: opacity;
  }

  @keyframes svc-slide-fade {
    0%   { opacity: 0; }
    4%   { opacity: 1; }
    29%  { opacity: 1; }
    33%  { opacity: 0; }
    100% { opacity: 0; }
  }

  /* Reduced motion: no slideshow — show only the first image. */
  @media (prefers-reduced-motion: reduce) {
    .svc-slide {
      animation: none;
      opacity: 0;
    }
    .svc-slide:first-child {
      opacity: 1;
    }
  }
</style>
