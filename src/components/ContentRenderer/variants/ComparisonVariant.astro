---
// src/components/ContentRenderer/variants/ComparisonVariant.astro
/**
 * Comparison Variant — options side by side (house / townhouse / condo,
 * composite / wood, commercial / home) inside a <Band>. Items are the
 * columns; `rows` are the shared row labels. Everything stays visible (no
 * tabs), because the comparison is the point; on phones the columns stack.
 *
 *   <ContentRenderer
 *     items={frontmatter.comparison.columns}
 *     rows={frontmatter.comparison.rows}
 *     variant="ComparisonVariant"
 *     title={frontmatter.comparison.heading}
 *     description={frontmatter.comparison.intro}
 *   />
 *
 * When OfferingsVariant's filter picks an option (`offerings:filter`), the
 * column with that id is highlighted. `featureCards` renders the columns as
 * navy gradient cards with white text (OfferingsVariant's linked-card look,
 * for a white band); those are never highlighted, since no option is more
 * important than another.
 */
import type { BaseVariantProps } from "../ContentRenderer.types";
import Band from "@/components/Bands/Band.astro";
import ComparisonColumn from "@/components/LoopComponents/ComparisonColumn.astro";

interface Props extends BaseVariantProps {
  /** Row labels shared by every column. */
  rows: string[];
  /** Navy gradient cards, no highlight. */
  featureCards?: boolean;
}

const { items = [], rows = [], title, description, id, featureCards = false } = Astro.props as Props;
const columns = items as any[];
---

<Band class="comparison-band">
  <div id={id}>
    {title && <h2>{title}</h2>}
    {description && <p>{description}</p>}

    <div
      class={`comparison-grid ${featureCards ? "comparison-grid--feature" : ""}`}
      data-comparison={featureCards ? undefined : ""}
      style={`--comparison-cols: ${columns.length}`}
    >
      {columns.map((column) => (
        <ComparisonColumn id={column.id} label={column.label} rows={rows} cells={column.cells} />
      ))}
    </div>
  </div>
</Band>

<script>
  function highlight(type: string | undefined) {
    document.querySelectorAll<HTMLElement>("[data-comparison] .comparison-col").forEach((col) => {
      col.classList.toggle("is-selected", col.dataset.type === type);
    });
  }

  document.addEventListener("offerings:filter", (event) => {
    highlight((event as CustomEvent<{ id: string }>).detail.id);
  });

  // The filter may have applied (e.g. from #condo or #commercial) before this script ran.
  const pressed = document.querySelector<HTMLElement>('[data-offerings] [data-filter][aria-pressed="true"]');
  highlight(pressed?.dataset.filter);
</script>

<style is:global>
  .band-prose .comparison-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }
  @media (min-width: 768px) {
    .band-prose .comparison-grid {
      grid-template-columns: repeat(min(var(--comparison-cols), 2), minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .band-prose .comparison-grid {
      grid-template-columns: repeat(var(--comparison-cols), minmax(0, 1fr));
    }
  }
  .comparison-col {
    padding: 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in oklab, currentColor 18%, transparent);
    background: color-mix(in oklab, currentColor 4%, transparent);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .comparison-col.is-selected {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 2px var(--color-accent);
  }
  /* Navy gradient cards (featureCards), matching OfferingsVariant's linked
     cards. */
  .comparison-grid--feature .comparison-col {
    border: 0;
    color: var(--color-bg);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-400) 100%);
    box-shadow: 0 12px 30px rgba(0, 28, 70, 0.22);
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  /* Beats the Bands heading color rule (.bands .band:nth-of-type(odd) h3). */
  .bands .band .band-prose .comparison-grid--feature h3 {
    color: var(--color-bg);
  }
  .band-prose .comparison-col h3 {
    font-size: 1.375rem;
    margin-bottom: 1rem;
  }
  .comparison-col dl {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
  }
  .comparison-row dt {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 0.25rem;
  }
  .band-prose .comparison-row dd {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }
</style>
