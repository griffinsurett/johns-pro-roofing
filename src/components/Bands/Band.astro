---
// src/components/Bands/Band.astro
/**
 * Band — one content section inside a <Bands> wrapper.
 *
 * Stack as many <Band> blocks as you want; backgrounds alternate
 * automatically (odd = white, even = brand navy with light text) via the
 * `:nth-of-type` rules in <Bands>. Authors never set a color — just add
 * content. Put any markup/MDX inside; headings and prose are styled by the
 * `.band-prose` rules so copy reads consistently across bands.
 *
 * Pass an `image` (imported asset) to render a side-by-side layout: image on
 * one side, the slotted copy on the other. `reverse` puts the image on the
 * right. Without an `image` the band stays full-width text, exactly as before.
 *
 * @example
 *   <Bands>
 *     <Band image={roofImg} imageAlt="New shingle roof">
 *       ## When it's time to replace your roof
 *       Most asphalt-shingle roofs...
 *     </Band>
 *     <Band image={crewImg} reverse>
 *       ## What a replacement includes
 *       - Tear-off and inspection...
 *     </Band>
 *   </Bands>
 */
import { Image } from "astro:assets";

interface Props {
  class?: string;
  /** Imported image asset. When set, the band becomes a two-column image+text. */
  image?: ImageMetadata | string;
  imageAlt?: string;
  /** Place the image on the right instead of the left. */
  reverse?: boolean;
}
const {
  class: className = "",
  image,
  imageAlt = "",
  reverse = false,
} = Astro.props as Props;

const hasImage = Boolean(image);
---

<section class={`band ${hasImage ? "band--split" : ""} ${className}`}>
  {
    hasImage ? (
      <div class={`container band-split ${reverse ? "band-split--reverse" : ""}`}>
        <div class="band-split__media">
          {typeof image === "string" ? (
            <img src={image} alt={imageAlt} class="band-split__img" loading="lazy" />
          ) : (
            <Image
              src={image as ImageMetadata}
              alt={imageAlt}
              widths={[480, 768, 960]}
              sizes="(min-width: 768px) 45vw, 100vw"
              class="band-split__img"
              loading="lazy"
            />
          )}
        </div>
        <div class="band-prose band-split__copy">
          <slot />
        </div>
      </div>
    ) : (
      <div class="container band-prose">
        <slot />
      </div>
    )
  }
</section>

<style is:global>
  /* Side-by-side image + copy. Stacks on mobile, two columns from md up. */
  .band-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  @media (min-width: 768px) {
    .band-split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    /* Reverse: copy first, image second (image lands on the right). */
    .band-split--reverse .band-split__media {
      order: 2;
    }
  }
  /* Fixed, balanced aspect ratio so short-copy bands don't balloon the image.
     The photo fills that box (cover) regardless of how tall the copy is. */
  .band-split__media {
    aspect-ratio: 4 / 3;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }
  .band-split__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
