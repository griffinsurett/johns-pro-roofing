---
// src/components/LoopComponents/TypeListItem.astro
/**
 * TypeListItem — one roofing type as a prose list item:
 * "**Title** — description". Rendered by TypeListBandVariant.
 */
export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props as Props;
---

<li>
  <strong>{title}</strong>
  {description && <> — {description}</>}
</li>
