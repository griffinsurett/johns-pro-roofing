---
// src/components/LoopComponents/BlogFeedCard.astro
/**
 * BlogFeedCard — one post in the blog index feed: image, title, date /
 * author / tags line, description and a Read More button. Carries
 * `data-pagination-item` for the client-side query-param pagination.
 * Rendered by BlogFeedVariant.
 */
export interface Props {
  title: string;
  url: string;
  description?: string;
  publishDate?: string | Date;
  authorNames?: string[];
  tags?: string[];
  featuredImageSrc?: string;
  featuredImageAlt?: string;
}

const {
  title,
  url,
  description,
  publishDate,
  authorNames = [],
  tags = [],
  featuredImageSrc,
  featuredImageAlt,
} = Astro.props as Props;
---

<article data-pagination-item class="bg-bg border border-surface rounded-xl overflow-hidden shadow-sm">
  {featuredImageSrc && (
    <a href={url} class="block">
      <img src={featuredImageSrc} alt={featuredImageAlt} class="w-full h-56 object-cover" loading="lazy" />
    </a>
  )}

  <div class="p-6">
    <h3 class="text-2xl font-bold text-heading leading-tight">
      <a href={url} class="hover:text-primary transition-colors">{title}</a>
    </h3>

    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-text">
      {publishDate && (
        <time datetime={new Date(publishDate).toISOString()}>
          {new Date(publishDate).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}
        </time>
      )}
      {authorNames.length > 0 && <span>By {authorNames.slice(0, 1).join(", ")}</span>}
      {tags.length > 0 && <span>{tags.slice(0, 2).join(", ")}</span>}
    </div>

    {description && <p class="mt-4 text-text leading-relaxed">{description}</p>}

    <div class="mt-6">
      <a
        href={url}
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-md bg-primary text-white font-semibold hover:opacity-90 transition-opacity"
      >
        Read More
      </a>
    </div>
  </div>
</article>
