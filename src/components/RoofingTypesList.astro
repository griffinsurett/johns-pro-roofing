---
// src/components/RoofingTypesList.astro
/**
 * RoofingTypesList — the roofing systems for a service as an in-content
 * <Band>: a heading + a bulleted "**Title** — description" list beside an
 * image. A thin wrapper: the roofing-types query (filtered by `service`)
 * runs through ContentRenderer, laid out by TypeListBandVariant.
 */
import ContentRenderer from "@/components/ContentRenderer/ContentRenderer.astro";
import { query, sortByOrder, normalizeReference } from "@/utils/query";

interface Props {
  /** Service id to filter by (e.g. "flat-roofing"). */
  service: string;
  /** Band heading. */
  heading?: string;
  /** Image asset for the band's media side. */
  image?: ImageMetadata | string;
  imageAlt?: string;
  /** Image on the right (matches the original band). */
  reverse?: boolean;
}

const {
  service,
  heading = "Systems we install and service",
  image,
  imageAlt = "",
  reverse = false,
} = Astro.props as Props;

const typesQuery = query("roofing-types")
  .where((e: any) => normalizeReference(e.data.service).some((ref: any) => ref.id === service))
  .orderBy(sortByOrder());
---

<ContentRenderer
  query={typesQuery}
  variant="TypeListBandVariant"
  title={heading}
  image={image}
  imageAlt={imageAlt}
  reverse={reverse}
/>
