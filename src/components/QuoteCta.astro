---
// src/components/QuoteCta.astro
/**
 * QuoteCta — conversion section for service pages: the CtaBanner's pitch
 * (photo + red gradient, selling-points, phone) on the left, with the wired
 * QuoteForm embedded on the right so visitors convert in place (no page jump).
 *
 * Drop-in replacement for <CtaBanner /> on service pages. Reuses the same
 * `cta` frontmatter shape, so a page's existing `cta:` block drives the copy.
 *
 * Standalone service pages (decks, remodeling, additions) also pass:
 *  - `serviceId`: the reviews use getServiceReviews (this service's reviews,
 *    else the "featured" set) instead of every review on the site.
 *  - a default slot: their own detailed form replaces the generic QuoteForm.
 *  - optionally `image`: the page's own background photo. Until a service has
 *    one, the default photo is the fallback (`image={null}` drops the photo
 *    for a solid brand-red panel).
 * With a custom form, the phone line sits right under the description (above
 * the reviews) so it's visible without scrolling the pinned pitch.
 */
import PhoneLink from "@/components/PhoneLink.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import QuoteForm from "@/components/Form/forms/QuoteForm.astro";
import ContactForm from "@/components/Form/forms/ContactForm.astro";
import ContentRenderer from "@/components/ContentRenderer/ContentRenderer.astro";
import { query, sortByOrder } from "@/utils/query";
import { getServiceReviews } from "@/utils/serviceReviews";
import type { CTAData } from "@/content/schema";
import serviceRoofRepair from "@/assets/commercial-working.webp";

interface Props {
  id?: string;
  cta?: CTAData;
  /** Which form to embed: the short quote form (default) or the full contact form (adds a message field). */
  form?: "quote" | "contact";
  /** Heading above the embedded form panel. */
  formTitle?: string;
  /** Subtext under the form-panel heading. */
  formDescription?: string;
  /** Show this service's reviews (falling back to the featured set) instead
   *  of every review. */
  serviceId?: string;
  /** Background photo. `null` drops it for a solid brand-red panel. */
  image?: ImageMetadata | null;
}

const {
  id = "quote-form",
  cta = {},
  form = "quote",
  formTitle = "Request a free estimate",
  formDescription = "No cost, no obligation — we'll be in touch fast.",
  serviceId,
  image = serviceRoofRepair,
} = Astro.props as Props;
const hasCustomForm = Astro.slots.has("default");
const Form = form === "contact" ? ContactForm : QuoteForm;

const title = cta?.title ?? "Ready for a";
const accent = cta?.accent ?? "better";
const titleAfter = cta?.titleAfter ?? "roof?";
const description =
  cta?.description ??
  "Tell us about your project and we'll get you a free, no-obligation estimate.";

// Social proof: real reviews next to the form, rendered through ContentRenderer
// (TestimonialMarqueeVariant). With a serviceId: that service's reviews, else
// the "featured" set (getServiceReviews); otherwise every review.
const reviewIds = serviceId ? (await getServiceReviews(serviceId)).map((t) => t.id) : null;
const reviewsQuery = reviewIds
  ? query("testimonials")
      .where((e: any) => reviewIds.includes(e.id))
      .orderBy(sortByOrder())
  : query("testimonials").orderBy(sortByOrder());
---

<section class="relative bg-accent scroll-mt-24" id={id}>
  {/* Background layers. Clipped here rather than on the section: overflow on
      the section would stop the pinned pitch (position: sticky) from sticking. */}
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    {
      image && (
        <img
          src={image.src}
          alt=""
          class="absolute inset-0 w-full h-full object-cover"
        />
      )
    }
    {/* Red gradient overlay: opaque left → transparent right */}
    <div
      class="absolute inset-0 bg-[linear-gradient(90deg,var(--color-accent)_0%,color-mix(in_oklab,var(--color-accent)_92%,transparent)_45%,color-mix(in_oklab,var(--color-accent)_70%,transparent)_80%,color-mix(in_oklab,var(--color-accent)_55%,transparent)_100%)]"
    >
    </div>
  </div>

  <div class="container relative z-10 py-[80px]">
    {/* A page's own detailed form is much taller than the generic one, so the
        pitch pins to the top and stays in view while the visitor fills it in. */}
    <div class={`grid gap-10 lg:grid-cols-2 lg:gap-16 ${hasCustomForm ? "lg:items-start" : "lg:items-center"}`}>
      {/* Pitch */}
      <div class={`text-bg ${hasCustomForm ? "lg:sticky lg:top-32" : ""}`}>
        <SectionHeading
          align="left"
          class="!mb-0"
          heading={{ before: title, text: accent, after: titleAfter }}
          headingClass="!text-bg !text-[clamp(32px,4.5vw,52px)] leading-[1.05] !mb-4"
          emphasisClass="italic"
        />
        <p class="text-bg/90 text-lg leading-relaxed mb-8 max-w-[480px]">
          {description}
        </p>

        {hasCustomForm && (
          <div class="flex items-center gap-3 text-bg mb-8">
            <span class="text-bg/80">Prefer to call?</span>
            <PhoneLink variant="phone" tone="white" size="lg" />
          </div>
        )}

        <ContentRenderer
          query={reviewsQuery}
          variant="TestimonialMarqueeVariant"
          compact={hasCustomForm}
        />

        {!hasCustomForm && (
          <div class="flex items-center gap-3 text-bg">
            <span class="text-bg/80">Prefer to call?</span>
            <PhoneLink variant="phone" tone="white" size="lg" />
          </div>
        )}
      </div>

      {/* Quote form */}
      <div class="bg-bg rounded-2xl shadow-xl p-6 md:p-8">
        <h3 class="text-2xl font-bold text-heading mb-1">{formTitle}</h3>
        {formDescription && <p class="text-text mb-6">{formDescription}</p>}
        {hasCustomForm ? <slot /> : <Form />}
      </div>
    </div>
  </div>
</section>
