---
// src/components/GalleryMarquee.astro
/**
 * GalleryMarquee — a continuous auto-scrolling row of gallery photos. A thin
 * wrapper so it can be dropped anywhere with no props (e.g. inside the
 * StatsVariant "Why Choose Us" band): the gallery query runs through
 * ContentRenderer, the layout is GalleryMarqueeVariant, each photo a
 * GalleryTile.
 */
import ContentRenderer from "@/components/ContentRenderer/ContentRenderer.astro";
import { query, sortByOrder } from "@/utils/query";

interface Props {
  /** Seconds for one full loop (lower = faster). */
  speed?: number;
  class?: string;
}
const { speed = 45, class: className = "" } = Astro.props as Props;
---

<ContentRenderer
  query={query("gallery").orderBy(sortByOrder())}
  variant="GalleryMarqueeVariant"
  speed={speed}
  className={className}
/>
