---
// src/components/ServiceBands.astro
/**
 * ServiceBands — lists a collection's top-level services as alternating
 * white/navy bands (the services hub). A thin wrapper: the query runs through
 * ContentRenderer, the layout is ServiceBandsVariant and each band is a
 * ServiceBandCard.
 */
import type { CollectionKey } from "astro:content";
import ContentRenderer from "@/components/ContentRenderer/ContentRenderer.astro";
import { roots, sortByOrder } from "@/utils/query";

interface Props {
  /** Collection to list the top-level (root) items of. */
  collection: CollectionKey;
  /** Button label shown on each service band. */
  ctaLabel?: string;
}

const { collection, ctaLabel = "Learn More" } = Astro.props as Props;
---

<ContentRenderer
  query={roots(collection).orderBy(sortByOrder())}
  variant="ServiceBandsVariant"
  ctaLabel={ctaLabel}
/>
