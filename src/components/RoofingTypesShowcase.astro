---
// src/components/RoofingTypesShowcase.astro
/**
 * RoofingTypesShowcase — the roofing systems for a service as an image
 * slideshow paired with a selectable list, inside a <Band>. A thin wrapper:
 * the roofing-types query (filtered by `service`, optionally by `tag`) runs
 * through ContentRenderer and TypesShowcaseVariant renders it.
 */
import ContentRenderer from "@/components/ContentRenderer/ContentRenderer.astro";
import { query, sortByOrder, normalizeReference } from "@/utils/query";

interface Props {
  /** Service id to filter by (e.g. "commercial-roof-repairs"). */
  service: string;
  heading?: string;
  /** Image on the right instead of the left (desktop). */
  reverse?: boolean;
  /** Only types carrying this tag (e.g. "commercial"). */
  tag?: string;
}

const { service, heading, reverse = false, tag } = Astro.props as Props;

const typesQuery = query("roofing-types")
  .where(
    (e: any) =>
      normalizeReference(e.data.service).some((ref: any) => ref.id === service) &&
      (!tag || e.data.tags?.includes(tag)),
  )
  .orderBy(sortByOrder());
---

<ContentRenderer
  query={typesQuery}
  variant="TypesShowcaseVariant"
  listHeading={heading}
  reverse={reverse}
/>
