---
// src/components/RoofingTypesShowcase.astro
/**
 * RoofingTypesShowcase — the roofing systems for a service shown as an image
 * slideshow paired with a selectable list (the active type is underlined).
 * Auto-advances and is clickable. Renders as a <Band> so it joins the page's
 * alternating banded layout. Data-driven from the roofing-types collection,
 * filtered by `service` (same source as the card/list variants).
 */
import { getImage } from "astro:assets";
import Band from "@/components/Bands/Band.astro";
import RoofingTypesShowcaseClient from "@/components/RoofingTypesShowcase.tsx";
import { getRoofingTypes } from "@/utils/roofingTypes";
import { resolveImageMetadata } from "@/utils/images";

interface Props {
  /** Service id to filter by (e.g. "commercial-roof-repairs"). */
  service: string;
  heading?: string;
  /** Image on the right instead of the left (desktop). */
  reverse?: boolean;
}

const { service, heading, reverse = false } = Astro.props as Props;

/**
 * Resolve a prepared item's image to an optimized src + srcset.
 *
 * The slideshow is a React island, so it can't use <Image> — we run the images
 * through getImage here (build time) and hand the client plain strings.
 */
async function optimize(image: any): Promise<{ src: string; srcset?: string }> {
  if (typeof image === "string") return { src: image };
  const meta = resolveImageMetadata(image);
  if (!meta) return { src: "" };

  const variants = await Promise.all(
    [640, 960, 1280].map((width) =>
      getImage({ src: meta, width, format: "webp", quality: 72 }),
    ),
  );
  return {
    src: variants[1].src,
    srcset: variants
      .map((v, i) => `${v.src} ${[640, 960, 1280][i]}w`)
      .join(", "),
  };
}

const types = await getRoofingTypes({ service });
const items = await Promise.all(
  types.map(async (t: any) => {
    const { src, srcset } = await optimize(t.data.featuredImage);
    return {
      title: t.data.title,
      description: t.data.description,
      image: src,
      imageSrcset: srcset,
    };
  }),
);
---

<Band class="roofing-showcase-band">
  {heading && <h2>{heading}</h2>}
  <RoofingTypesShowcaseClient client:visible items={items} reverse={reverse} />
</Band>

<style is:global>
  /* Give the heading some breathing room above the showcase. */
  .roofing-showcase-band h2 {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
</style>
