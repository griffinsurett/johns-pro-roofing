---
// src/components/BusinessCredentials.astro
/**
 * BusinessCredentials — the credential lines under a service page's cost
 * section: NJ HIC registration, insurance, warranty. Every value comes from
 * `businessData` in src/content/siteData.ts, and each line renders only when
 * its value is set. Until John confirms a fact it stays unset and nothing
 * shows (no placeholder); fill it in once in siteData and it appears on every
 * page that uses this component.
 *
 *   <BusinessCredentials />                // HIC #, insurance, warranty
 *   <BusinessCredentials hic={false} />    // commercial-only pages
 *
 * `hic={false}` leaves the NJ Home Improvement Contractor number off pages
 * whose work isn't residential home improvement (commercial roofing, paving).
 */
import { businessData } from "@/content/siteData";

interface Props {
  /** Show the NJ HIC registration line (residential home-improvement work). */
  hic?: boolean;
}

const { hic = true } = Astro.props as Props;
const { njHicNumber, insurance, warranty } = businessData;
---

{hic && njHicNumber && <p>NJ Home Improvement Contractor registration #{njHicNumber}.</p>}
{insurance && <p>We are {insurance} in NJ.</p>}
{warranty && <p>Work is backed by {warranty}.</p>}
