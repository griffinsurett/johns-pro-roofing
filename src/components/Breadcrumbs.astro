---
// src/components/Breadcrumbs.astro
/**
 * Breadcrumbs — the visible breadcrumb trail for the current page. A thin
 * wrapper: `useBreadcrumbs` builds the trail (the same rules the breadcrumb
 * schema uses), ContentRenderer renders it with BreadcrumbVariant.
 */
import ContentRenderer from "@/components/ContentRenderer/ContentRenderer.astro";
import { useBreadcrumbs, type BreadcrumbOptions } from "@/utils/breadcrumbs";

interface Props extends BreadcrumbOptions {
  class?: string;
  listClass?: string;
  linkClass?: string;
  currentClass?: string;
  label?: string;
  separator?: string;
}

const {
  class: className,
  listClass = "flex flex-wrap items-center gap-2 text-sm",
  linkClass = "underline underline-offset-4",
  currentClass,
  label = "Breadcrumb",
  separator = "/",
  ...options
} = Astro.props;
const items = await useBreadcrumbs(Astro, Object.keys(options).length ? options : undefined);
---

<ContentRenderer
  items={items}
  variant="BreadcrumbVariant"
  className={className}
  label={label}
  listClass={listClass}
  linkClass={linkClass}
  currentClass={currentClass}
  separator={separator}
/>
