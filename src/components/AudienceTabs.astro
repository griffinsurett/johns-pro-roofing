---
// src/components/AudienceTabs.astro
/**
 * AudienceTabs — a toggle that swaps a page section between audiences
 * (e.g. Commercial / Residential). Each tab's content is a named slot matching
 * the tab id. Every panel is in the HTML (indexable); the script only toggles
 * which one shows.
 *
 * The URL hash selects a tab (/services/general-contractors#residential), so
 * an ad or link can open straight to one audience.
 *
 * @example
 *   <AudienceTabs tabs={[{ id: "commercial", label: "Commercial" }, { id: "residential", label: "Residential" }]}>
 *     <div slot="commercial">...</div>
 *     <div slot="residential">...</div>
 *   </AudienceTabs>
 */
interface Tab {
  id: string;
  label: string;
}

interface Props {
  tabs: Tab[];
  heading?: string;
}

const { tabs, heading } = Astro.props as Props;
---

<div class="audience-tabs" data-audience-tabs>
  <div class="container pt-[60px] lg:pt-[80px] pb-8 flex flex-col items-center gap-5">
    {heading && <h2 class="text-center !text-[clamp(1.5rem,3vw,2.25rem)] font-extrabold">{heading}</h2>}
    <div role="tablist" class="audience-tabs__list">
      {tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          data-tab={tab.id}
          class="audience-tabs__tab"
        >
          {tab.label}
        </button>
      ))}
    </div>
  </div>

  {tabs.map((tab, i) => (
    <div
      role="tabpanel"
      id={`panel-${tab.id}`}
      aria-labelledby={`tab-${tab.id}`}
      hidden={i !== 0}
    >
      <slot name={tab.id} />
    </div>
  ))}
</div>

<style>
  .audience-tabs__list {
    display: inline-flex;
    padding: 0.375rem;
    gap: 0.375rem;
    border-radius: 9999px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px rgba(0, 28, 70, 0.12);
  }
  .audience-tabs__tab {
    padding: 0.75rem clamp(1.25rem, 4vw, 2.5rem);
    border-radius: 9999px;
    font-weight: 800;
    font-size: clamp(1rem, 2vw, 1.15rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-brand-navy);
    transition: background-color 0.2s, color 0.2s;
  }
  .audience-tabs__tab[aria-selected="true"] {
    background: var(--color-brand-navy);
    color: var(--color-bg);
  }
  .audience-tabs__tab:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-audience-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

    const select = (id: string, focus = false) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.tab === id;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
        const panel = root.querySelector<HTMLElement>(`#panel-${tab.dataset.tab}`);
        if (panel) panel.hidden = !active;
        if (active && focus) tab.focus();
      });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        select(tab.dataset.tab!);
        history.replaceState(null, "", `#${tab.dataset.tab}`);
      });
      tab.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        const next = tabs[(i + step + tabs.length) % tabs.length];
        select(next.dataset.tab!, true);
      });
    });

    const fromHash = location.hash.slice(1);
    if (tabs.some((tab) => tab.dataset.tab === fromHash)) {
      select(fromHash);
      root.scrollIntoView();
    }
  });
</script>
