---
import BaseLayout from "@/layouts/BaseLayout.astro";

import FrontPageHero2 from "@/layouts/FrontPageHero2.astro";
import ContentRenderer from "@/components/ContentRenderer/ContentRenderer.astro";
import { query, sortByOrder } from "@/utils/query";
import Button from "@/components/Button/Button";
import AboutIntro from "@/components/AboutIntro.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import { getServiceAreaNames } from "@/utils/serviceAreas";
import aboutImage from "@/assets/john-on-roof.webp";
import heroImage from "@/assets/commercial-7.webp";
import WhoWeServe from "@/components/WhoWeServe.astro";
import RoofingTypes from "@/components/RoofingTypes.astro";

// Service-area states (single source of truth) → full-name label for copy.
const serviceAreaLabel = await getServiceAreaNames();

---

<BaseLayout
  title="Professional Roofing Services"
  description="Commercial roofing services in Somerset, New Jersey. Flat-roof systems, repairs, and replacements for businesses and property managers. Free estimates and financing available."
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=Saira+Condensed:ital,wght@1,700;1,800&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main class="flex-1">
    <FrontPageHero2
      heading={{ before: "Roofing That Keeps Your", text: "Business", after: "Covered." }}
      description="Commercial roofing that protects your business — flat-roof systems, replacements, and repairs scheduled around your operations. Free estimates and financing, from a local team you can count on."
      primaryCTA={{ text: "Get a Free Quote", link: "/contact-us" }}
      image={heroImage}
      video="/commercial-vid.mp4"
      personAlt="John's Pro Roofing crew member pointing at a finished roof"
    />

    <ContentRenderer
      query={query("selling-points").orderBy(sortByOrder())}
      variant="MarqueeVariant"
    />

    <section class="about-section" id="about">
      <div class="container">
        <AboutIntro
          reverse={true}
          video={null}
          image={aboutImage}
          imageAlt="John with a satisfied John's Pro Roofing customer"
          description="No job is too big or too small. John's Pro Roofing LLC works with property managers, facility managers, and building owners across New Jersey on commercial roofing and asphalt paving — straightforward service, honest communication, and dependable results, all backed by our workmanship warranty."
        />
      </div>
    </section>

    {/* Roofing systems we install — image cards from the roofing-types collection. */}
    <RoofingTypes />

    {/* Who we serve — red-gradient photo band with a numbered list of the
        commercial audiences John's Pro Roofing works with. */}
    <WhoWeServe />

    {/* Roofing pointers — heading left, copy + stats right (Axel's-style).
        Stats are driven by the `stats` collection. */}
    <ContentRenderer
      query={query("stats").orderBy(sortByOrder())}
      variant="StatsVariant"
      id="why-us"
      pretitle="Why Choose Us"
      body={[
        "We don't cut corners. Every job gets a thorough inspection, honest recommendations, and quality materials installed by a crew that treats your property like their own — no subs, no surprises.",
        "From storm-damage repairs to full replacements, we back our work with a 25-year workmanship warranty and a satisfaction guarantee. If it's not right, we make it right.",
      ]}
    >
      <h2 slot="heading" class="section-title !text-[clamp(36px,5vw,56px)] leading-[1.05]">
        Roofs that last,
        <span class="italic text-accent"> done right, </span>
        the first time.
      </h2>
    </ContentRenderer>

    {/* Full services list (rows with arrow CTAs). */}
    <ContentRenderer
      query={query("services")
        .where((entry) => Boolean(entry.data.cardSize))
        .orderBy(sortByOrder())}
      variant="ServiceListVariant"
      className="!border-t-0"
      id="services-list"
    />

    <section id="projects">
      <ContentRenderer
        query={query("projects")
          .where((entry) =>
            entry.data.tags?.includes("featured") &&
            Boolean(entry.data.beforeImage && entry.data.afterImage)
          )
          .orderBy(sortByOrder())}
        variant="BeforeAfterVariant"
        pretitle="Recent Projects"
        title="Real Properties."
        accentTitle="Real Work."
        description={`A look at recent commercial roofing transformations across ${serviceAreaLabel}.`}
        dark={true}
        columns={2}
        showButtonSection={false}
      />
    </section>

    <div id="testimonials" class="pt-[100px]">

      <ContentRenderer
        query={query("testimonials").orderBy(sortByOrder())}
        variant="TestimonialCarouselVariant"
        collectionUrl="/testimonials"
        collectionTitle="Reviews"
      />
    </div>

    {/* CTA banner — replaces the contact form (form commented out below) */}
    <CtaBanner />

    {/* Contact form — commented out, replaced by the CTA banner above.
    <section class="contact-section" id="quote-form">
      <svg
        class="contact-watermark left-[-50px] top-[10%] rotate-[15deg]"
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M10 90 L50 40 L90 90" stroke="rgba(255,255,255,0.04)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="42" y="70" width="16" height="16" stroke="rgba(255,255,255,0.04)" stroke-width="3" fill="none" />
        <line x1="50" y1="70" x2="50" y2="86" stroke="rgba(255,255,255,0.04)" stroke-width="2" />
        <line x1="42" y1="78" x2="58" y2="78" stroke="rgba(255,255,255,0.04)" stroke-width="2" />
      </svg>
      <svg
        class="contact-watermark right-[-50px] bottom-[5%] rotate-[-15deg]"
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M10 90 L50 40 L90 90" stroke="rgba(255,255,255,0.04)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="42" y="70" width="16" height="16" stroke="rgba(255,255,255,0.04)" stroke-width="3" fill="none" />
        <line x1="50" y1="70" x2="50" y2="86" stroke="rgba(255,255,255,0.04)" stroke-width="2" />
        <line x1="42" y1="78" x2="58" y2="78" stroke="rgba(255,255,255,0.04)" stroke-width="2" />
      </svg>

      <div class="container relative z-[3]">
        <h2 class="contact-title">Request an estimate</h2>
        <form class="max-w-[900px] mx-auto">
          <div class="form-grid">
            <div class="form-group">
              <input type="text" placeholder="Name" required class="form-input" />
              <input type="email" placeholder="Email*" required class="form-input" />
            </div>
            <div class="form-group">
              <textarea placeholder="Message" required class="form-input form-textarea"></textarea>
            </div>
          </div>

          <div class="max-w-[900px] mx-auto mb-9">
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" required class="w-[18px] h-[18px] accent-[var(--color-accent-red)] mt-[3px] shrink-0" />
              <span class="consent-text">
                This site is protected by reCAPTCHA and the Google Privacy Policy and Terms of Service apply.
              </span>
            </label>
          </div>

          <div class="text-center">
            <Button variant="primary" size="lg" type="submit">Submit</Button>
          </div>
        </form>
      </div>
    </section>
    */}

  </main>
</BaseLayout>
