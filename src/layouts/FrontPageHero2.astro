---
// src/layouts/FrontPageHero2.astro
/**
 * Front Page Hero — variation 2 ("fph2")
 *
 * Split background: image on the left half, looping video on the right half.
 * The cut-out "john-pointing" person is absolutely centered over the seam.
 * Text content (heading / subtitle / CTA) overlays the left half with a scrim.
 */
import { Image } from "astro:assets";
import Button from "@/components/Button/Button";
import PhoneLink from "@/components/PhoneLink.astro";
import GoogleRating from "@/components/GoogleRating.astro";
import Video from "@/components/Video/Video.astro";
import BackgroundVideo from "@/components/Video/BackgroundVideo.astro";
import bgImage from "@/assets/john-on-roof.webp";
import personImage from "@/assets/john-pointing.png";

type Heading = string | { before?: string; text?: string; after?: string };

export interface Props {
  /** Small kicker above the headline. */
  eyebrow?: string;
  /** Segmented headline: `{ before, text, after }` where `text` is the accent
   *  emphasis. When provided, it drives the H1 (overriding titleTop/Bottom/After).
   *  A plain string renders with no accent split. */
  heading?: Heading;
  /** Headline lead-in (navy). */
  titleTop?: string;
  /** Headline emphasis (accent red). */
  titleBottom?: string;
  /** Optional text after the emphasis, completing the headline (navy). */
  titleAfter?: string;
  description?: string;
  /** Left-half background image. */
  image?: ImageMetadata;
  /** Right-half background video (public path). */
  video?: string;
  /** Foreground cut-out person, centered. */
  person?: ImageMetadata;
  personAlt?: string;
  primaryCTA?: { text: string; link: string };
  /** Show the button row (primary CTA + phone). Set false to hide both. */
  showButtons?: boolean;
  /** Show the Google rating trust row. */
  googleRating?: boolean;
  className?: string;
  id?: string;
}

const {
  eyebrow,
  heading,
  titleTop = "Your Roof,",
  titleBottom = "Done Right",
  titleAfter = "the First Time.",
  description,
  image = bgImage,
  video = "/placeholder-vid.mp4",
  person = personImage,
  personAlt = "John's Pro Roofing crew member pointing at a finished roof",
  primaryCTA = { text: "Get a Free Quote", link: "/contact-us" },
  showButtons = true,
  googleRating = true,
  className = "",
  id = "hero",
} = Astro.props;

// A segmented `heading` (or plain string) overrides the titleTop/Bottom/After
// props so a page can drive the headline from its frontmatter `heading` field.
const headingObj =
  heading && typeof heading === "object" ? heading : undefined;
const headingStr = typeof heading === "string" ? heading : undefined;

const h = {
  before: headingObj?.before ?? (headingStr ? undefined : titleTop),
  text: headingObj?.text ?? (headingStr ?? (headingObj ? undefined : titleBottom)),
  after: headingObj?.after ?? (headingStr ? undefined : titleAfter),
};
---

<section
  id={id}
  class={`relative overflow-hidden bg-surface xl:min-h-[clamp(560px,85vh,900px)] ${className}`}
>
  {/* ── Background image + white overlay. Covers the full section on desktop;
        on mobile it fills the top text panel. Anchored top+bottom (inset-y-0)
        so it stretches to the actual text-panel height instead of a fixed vh —
        otherwise long copy grows past the image and leaves a gap. The mobile
        video banner sits below the text panel and isn't covered. ── */}
  <div class="absolute inset-x-0 top-0 bottom-[var(--fph2-media-h,56.25vw)] xl:bottom-0 xl:inset-0">
    <Image
      src={image}
      alt=""
      aria-hidden="true"
      widths={[960, 1280, 1600]}
      sizes="100vw"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    {/* White overlay so the panel reads light for dark text. Mobile uses the
        same opacity range as desktop, just top→bottom instead of left→right. */}
    <div
      class="absolute inset-0 bg-[linear-gradient(180deg,rgba(255,255,255,0.95)_0%,rgba(255,255,255,0.9)_45%,rgba(255,255,255,0.82)_100%)] xl:bg-[linear-gradient(90deg,rgba(255,255,255,0.85)_0%,rgba(255,255,255,0.72)_45%,rgba(255,255,255,0.5)_100%)]"
    >
    </div>
  </div>

  {/* Right video panel (lg+), clipped with a slanted left edge. Ambient bg
      video: autoplays muted + loops, pause/play button on hover. */}
  <div class="fph2-video hidden xl:block absolute inset-y-0 right-0 w-[58%]">
    <BackgroundVideo src={video} tintClass="bg-primary/15" hoverControls />
  </div>

  {/* Desktop foreground person (lg+), centered over the seam */}
  <Image
    src={person}
    alt={personAlt}
    widths={[480, 720, 960]}
    sizes="40vw"
    class="hidden xl:block absolute bottom-0 left-1/2 -translate-x-1/2 z-[2] h-[92%] w-auto object-contain object-bottom pointer-events-none"
    loading="eager"
    fetchpriority="high"
  />

  {/* ── Content. Desktop: overlaid left. Mobile: stacked text block on top.
      The outer wrapper is pointer-events-none so its empty right half doesn't
      block the video's hover button; the inner text block re-enables events. ── */}
  <div class="relative z-[3] w-full max-w-[1600px] mx-auto px-6 xl:px-12 pointer-events-none">
    <div
      class="flex flex-col justify-center items-start gap-5 max-w-[560px] py-10 xl:py-16 min-h-[72vh] xl:min-h-[clamp(560px,85vh,900px)] pointer-events-auto"
    >
      {
        eyebrow && (
          <p class="inline-flex items-center text-[13px] font-bold uppercase tracking-[0.18em] text-accent">
            {eyebrow}
          </p>
        )
      }

      <h1
        class="font-display font-extrabold uppercase text-heading leading-[1] text-[clamp(42px,9vw,52px)] [text-wrap:balance]"
      >
        {h.before && <span>{h.before} </span>}
        {h.text && <span class="italic text-accent">{h.text}</span>}
        {h.after && <span> {h.after}</span>}
      </h1>

      {
        description && (
          <p class="text-[var(--color-text-muted)] text-lg leading-relaxed max-w-[460px]">
            {description}
          </p>
        )
      }

      {
        showButtons && (
          <div class="flex flex-wrap items-center gap-4 mt-1">
            {primaryCTA && (
              <Button variant="primary" size="lg" href={primaryCTA.link}>
                {primaryCTA.text}
              </Button>
            )}
            <PhoneLink variant="phone" tone="blue" size="lg" />
          </div>
        )
      }

      {googleRating && <GoogleRating tone="dark" />}
    </div>
  </div>

  {/* ── Mobile media banner (below lg): landscape video that autoplays muted
      and loops (the only way browsers allow autoplay), with native controls so
      visitors can unmute, pause, and scrub. ── */}
  <div class="xl:hidden relative w-full aspect-video">
    <Video
      src={video}
      alt=""
      lazy={false}
      controls={true}
      muted={true}
      autoplay={true}
      wrapperClass="absolute inset-0"
      class="object-cover"
    />
    {/* pointer-events-none so taps reach the native video controls */}
    <div class="absolute inset-0 bg-primary/15 z-[2] pointer-events-none"></div>
  </div>
</section>

<style>
  @media (min-width: 1280px) {
    /* Diagonal seam: the video panel's left edge slants. Top-left starts
       further right than the bottom-left, so the cut leans forward. */
    .fph2-video {
      clip-path: polygon(14% 0, 100% 0, 100% 100%, 0 100%);
    }
  }
</style>
