---
// src/layouts/TopBar.astro
/**
 * Top utility bar — sits above the site header.
 * Navy gradient strip: brand message on the left, social icons and phone on
 * the right. Service-area states come from the service-areas collection, the
 * icons from social-media (the same list as the footer).
 */
import FlagStarIcon from "@/components/FlagStarIcon.astro";
import PhoneLink from "@/components/PhoneLink.astro";
import ContentRenderer from "@/components/ContentRenderer/ContentRenderer.astro";
import { query } from "@/utils/query";
import { getServiceAreaAbbrs } from "@/utils/serviceAreas";

const areaLabel = await getServiceAreaAbbrs(); // "NJ, NY & PA"
---

<div class="top-bar" id="site-top-bar">
  <div class="top-bar-inner">
    <p class="top-bar-message">
      <FlagStarIcon class="top-bar-star" />
      Protecting Commercial Properties Across {areaLabel} — Roofing & Paving Done Right
    </p>
    <div class="top-bar-actions">
      <ContentRenderer
        query={query("social-media")}
        variant="SocialMediaVariant"
        size="sm"
        alignment="right"
        className="text-bg"
      />
      <span class="top-bar-divider" aria-hidden="true"></span>
      <PhoneLink variant="phone" tone="white" size="sm" />
    </div>
  </div>
</div>

<style>
  .top-bar {
    /* Scrolls away with the page; the header below is the sticky element. */
    position: relative;
    z-index: 1;
    background: var(--color-primary);
    padding-block: 8px;
  }

  /* Match the header's gutter exactly: max-width 1600px, 48px sides (24px mobile). */
  .top-bar-inner {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding-inline: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .top-bar-message {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: #fff;
    font-family: var(--font-family-headings);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .top-bar-message :global(.top-bar-star) {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    color: #fff;
    opacity: 0.9;
  }

  .top-bar-actions {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .top-bar-divider {
    width: 1px;
    height: 20px;
    background: rgb(255 255 255 / 0.3);
  }

  /* Tablets: not enough room for the message, icons and phone on one line,
     so the icons drop first (they're in the footer too). */
  @media (max-width: 1023px) {
    .top-bar-actions :global([id^="social-media"]),
    .top-bar-divider {
      display: none;
    }
  }

  @media (max-width: 767px) {
    /* Match the header's mobile gutter */
    .top-bar-inner {
      padding-inline: 24px;
    }
    /* On phones, drop the icons and phone link and shrink the message */
    .top-bar-actions {
      display: none;
    }
    .top-bar-message {
      font-size: 12px;
      justify-content: center;
      width: 100%;
      text-align: center;
    }
  }
</style>
