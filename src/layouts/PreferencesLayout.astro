---
// src/layouts/PreferencesLayout.astro
/**
 * Preferences Layout
 *
 * Consolidates all user preference systems:
 * - Cookie consent (Zest: blocks trackers from the head; this renders the UI)
 * - Accessibility preferences
 * - Language switcher (Google Translate)
 *
 * All use the same lazy-load, zero-impact pattern.
 */

// Cookie Consent Preferences
import CookiePreferencesButton from "@/integrations/preferences/consent/ui/CookiePreferencesButton";
import CookieConsentBanner from "@/integrations/preferences/consent/ui/CookieConsentBanner";

// Accessibility Preferences
import AccessibilityButton from "@/integrations/preferences/accessibility/ui/AccessibilityButton";

// Language Switcher
// Translation is OFF: not part of this client's package. To turn it back on, restore the commented lines in IntHeadScripts, IntBodyScripts, PreferencesLayout and AccessibilityModal, the Translate hosts in the vercel.json CSP, and the Google Translate / user-language / googtrans entries in src/utils/privacy.ts (see AGENTS.md).
// import BrowserTranslateScript from "@/integrations/preferences/language/core/scripts/BrowserTranslateScript.astro";

interface Props {
  buttonClassName?: string;
  /** Classes for the buttons row wrapper (layout/justify/gap). */
  className?: string;
  /** Render the visible preference buttons row. The cookie banner always
   *  renders regardless (it stays hidden in US mode, or once a choice is
   *  saved). Cookie preferences now lives in the footer's Legal links, so the
   *  footer sets this false. */
  showButtons?: boolean;
}

const {
  buttonClassName = "",
  className = "flex flex-wrap justify-center items-center gap-4",
  showButtons = true,
} = Astro.props;
---

{/* Zest blocks trackers synchronously in the head (IntHeadScripts). The
    banner hydrates independently and only shows when Zest asks for consent:
    never in US mode, where visitors opt out instead. */}
<CookieConsentBanner client:idle />

{/* Browser translation is OFF (not in this client's package); see the note
    in the frontmatter.
<BrowserTranslateScript enableNative={true} enableGoogle={true} />
*/}

{/* Preferences Buttons Row (optional) */}
{showButtons && (
  <div class={`text-xs ${className}`}>
    <CookiePreferencesButton client:visible className={buttonClassName} />
    <AccessibilityButton client:idle className={buttonClassName} />
  </div>
)}
