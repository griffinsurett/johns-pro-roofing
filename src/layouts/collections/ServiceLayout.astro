---
// src/layouts/collections/ServiceLayout.astro
/**
 * ServiceLayout — MDX-level hero wrapper for service pages.
 *
 * The page-level CollectionLayout is empty (content only). Each service MDX
 * wraps its own content in this layout, which renders a hero above it:
 *
 *   <ServiceLayout eyebrow="Roofing" title={frontmatter.title} ...>
 *     ...bands / content...
 *   </ServiceLayout>
 *
 * Every service gets the same default hero: ServiceHero (title + compact
 * callback form, full screen under the header) with the service's highlights
 * marquee pinned to its bottom. It's built from the props passed in plus the
 * service's own content:
 *   - `quickForm`  the callback form's heading, dropdown label and options
 *   - `marquee`    the highlights strip (falls back to the service's `features`)
 *   - `bannerImage` the hero background (schema-defaulted to `featuredImage`)
 * A page can still pass its own hero into the `hero` slot, but none should
 * need to.
 */
import ServiceHero from "@/layouts/ServiceHero.astro";
import QuickQuoteForm, { type QuickFormContent } from "@/components/Form/forms/QuickQuoteForm.astro";
import ContentRenderer from "@/components/ContentRenderer/ContentRenderer.astro";
import { query, related, sortByOrder, normalizeReference } from "@/utils/query";
import { getEntry } from "astro:content";
import CtaBanner from "@/components/CtaBanner.astro";
import { ctaData } from "@/content/siteData";

export interface Props {
  eyebrow?: string;
  title?: string;
  heading?: any;
  description?: string;
  image?: any;
  publishDate?: Date | string;
  author?: string | { collection: string; id: string };
  readingTime?: number;
  /** Service category (e.g. "Commercial Roofing"). When set, a portfolio band
   *  of before/after projects in the same category renders below the content. */
  category?: string;
  /** Legacy prop from the old SecondaryHero (call/estimate buttons). The
   *  service hero carries a callback form instead, so it's ignored. */
  heroActions?: boolean;
  /** This service's collection id (e.g. "commercial-roof-repairs"). Used to
   *  pull the service's own FAQs. Falls back to the last URL segment. */
  serviceId?: string;
}

const {
  eyebrow,
  title,
  heading,
  description,
  image,
  publishDate,
  author,
  readingTime,
  category,
  serviceId,
} = Astro.props as Props;

// Resolve the current service id (prop → last URL segment) so we can pull this
// service's FAQs.
const currentServiceId =
  serviceId ??
  Astro.url.pathname.replace(/\/$/, "").split("/").pop();

// FAQ band: FAQs whose `service` reference points at this service.
const faqQuery = currentServiceId
  ? related("faq", "service", currentServiceId).orderBy(sortByOrder())
  : null;
const faqCount = faqQuery ? (await faqQuery.all()).length : 0;

// Hero content from the service entry: callback form copy and marquee phrases.
const serviceEntry = currentServiceId
  ? await getEntry("services", currentServiceId)
  : undefined;
const serviceTitle = serviceEntry?.data.title ?? title ?? "";
// A service without its own `quickForm` still gets a working callback form.
const quickForm: QuickFormContent = serviceEntry?.data.quickForm ?? {
  heading: "Get a call back",
  selectLabel: "What do you need?",
  options: ["A free estimate", "Something else"],
  button: "Request a Call Back",
};
const ctaBannerData = serviceEntry?.data.ctaBanner;
// The banner's numbered points: how to get started. True for every service,
// so it's the default; a page can set its own `ctaBanner.points`.
const GET_STARTED_STEPS = [
  "Request your free estimate",
  "We come out and look at the job",
  "You get a clear, written price",
];
const marqueeItems = (
  serviceEntry?.data.marquee?.length
    ? serviceEntry.data.marquee
    : serviceEntry?.data.features ?? []
).map((item: string) => ({ title: item }));

// Portfolio band: projects whose referenced service shares this page's
// category, and which have a before/after pair. Resolving each project's
// `service` reference to its category lets one project (e.g. referencing
// flat-roofing) appear on every page in the "Commercial Roofing" family.
// We collect the matching ids here, then hand ContentRenderer a query so it
// runs its normal prepare pipeline (image resolution, URLs, etc.).
let portfolioIds: string[] = [];
if (category) {
  const allProjects = await query("projects")
    .where((e: any) => Boolean(e.data.beforeImage && e.data.afterImage))
    .all();

  const matches = await Promise.all(
    allProjects.map(async (p: any) => {
      const refs = normalizeReference(p.data.service);
      if (!refs.length) return null;
      const svcs = await Promise.all(
        refs.map((ref: any) => getEntry(ref.collection as any, ref.id))
      );
      const inCategory = svcs.some(
        (svc: any) => svc?.data?.category === category
      );
      return inCategory ? p.id : null;
    })
  );
  portfolioIds = matches.filter(Boolean) as string[];
}

const portfolioQuery = portfolioIds.length
  ? query("projects")
      .where((e: any) => portfolioIds.includes(e.id))
      .orderBy(sortByOrder())
  : null;
---
{/* Hero slot — the shared service hero unless a page passes `slot="hero"`. */}
<slot name="hero">
  <ServiceHero
    eyebrow={eyebrow}
    title={serviceTitle}
    heading={heading}
    description={description}
    image={image}
    serviceId={currentServiceId}
  >
    <QuickQuoteForm slot="aside" service={serviceTitle} content={quickForm} />
    {marqueeItems.length > 0 && <ContentRenderer slot="below" items={marqueeItems} variant="MarqueeVariant" />}
  </ServiceHero>
</slot>

<slot />

{
  portfolioQuery && (
    <ContentRenderer
      query={portfolioQuery}
      variant="BeforeAfterVariant"
      pretitle="Recent Projects"
      title="Recent"
      accentTitle="Work."
      description={`A look at recent ${(category ?? "").toLowerCase()} projects.`}
      dark={true}
      columns={2}
      showButtonSection={false}
    />
  )
}

{
  faqQuery && faqCount > 0 && (
    <section class="py-[80px] lg:py-[100px]">
      <div class="container">
        {/* No "View all FAQ" link: the page ends on the CTA banner instead. */}
        <ContentRenderer
          query={faqQuery}
          variant="AccordionVariant"
          collectionUrl={undefined}
          pretitle="FAQ"
          title="Frequently Asked Questions"
          description={`Common questions about ${(title ?? "this service").toLowerCase()}.`}
        />
      </div>
    </section>
  )
}

{/* Pre-footer CTA banner, as on the homepage, but fully action-oriented: the
    service's own headline, the steps to get started as the numbered points,
    and the estimate button pointing at this page's quote form. */}
<CtaBanner
  id="estimate-cta"
  cta={{
    ...ctaBannerData,
    points: ctaBannerData?.points ?? GET_STARTED_STEPS,
    primary: ctaBannerData?.primary ?? { text: ctaData.text, href: ctaData.link },
  }}
/>

